# Dependencias
node_modules/

# Variables de entorno y secretos (¡nunca subir!). Se mantiene .env.example.
.env
.env.local
.env.*.local

# Builds / salidas
dist/
build/

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store

# Editores
.vscode/
.idea/

# Zips de entregas
*.zip
.fuse_hidden*

# Documentos subidos (driver de almacenamiento local)
datos/

# Puerto y credenciales del túnel, regenerado por db/tunel.sh
db/.env.tunel

# Certificados de sello: contienen la CLAVE PRIVADA con la que se firma.
# Uno filtrado permite firmar documentos en nombre de MiFirma.
db/*.p12
db/*.pfx
*.pem
