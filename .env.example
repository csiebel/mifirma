# --- Base de datos ---
# La APLICACIÓN conecta con un rol `app_user` (sujeto a RLS). NUNCA el owner.
DATABASE_URL=postgres://app_user:cambiame@localhost:5432/payroll

# Solo para correr migraciones / alta de empresas (proceso privilegiado que
# evade RLS). No lo usa la app en runtime.
DATABASE_OWNER_URL=postgres://payroll_owner:cambiame@localhost:5432/payroll

# --- Identidad (Paso 1: validación de JWT) ---
# El login/SSO real y la gestión de claves se definen en el Paso 3.
AUTH_JWKS_URL=https://tu-idp.example.com/.well-known/jwks.json
AUTH_ISSUER=https://tu-idp.example.com/
AUTH_AUDIENCE=payroll-api

# DEV: secreto local para el login de desarrollo (UI). Si está seteado, la API
# verifica los tokens con él (HS256) en lugar del IdP. NO usar en producción.
AUTH_DEV_SECRET=dev-secreto-local-cambialo

PORT=3000

# --- Capa conversacional (IA) ---
# API key de Anthropic para el orquestador (console.anthropic.com).
ANTHROPIC_API_KEY=
# Modelo a usar (opcional). Modelos vigentes: docs.claude.com.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Consola de operador (proveedor del SaaS) ---
# Secreto para firmar la sesión (JWT) de los usuarios de la consola en /operador.
# Si no está, se usa AUTH_DEV_SECRET. Para producción, poné uno propio y fuerte:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# El primer superadmin se crea por línea de comando:
#   npm run operador -- crear-superadmin <usuario> <password> "<nombre>"
OPERADOR_JWT_SECRET=

# Clave para cifrar las credenciales de las pasarelas de pago (AES-256-GCM). Si no
# está, se usa OPERADOR_JWT_SECRET o AUTH_DEV_SECRET. Generá una propia para prod:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: si cambiás esta clave, los secretos ya guardados dejan de poder leerse.
GATEWAY_ENC_KEY=

# --- URL pública de la app (links en correos, etc.) ---
APP_BASE_URL=http://localhost:3000

# --- Correo (SMTP) y SMS/WhatsApp (Twilio) ---
# NO se configuran por variables de entorno: se cargan desde la consola de
# OPERADOR (/operador) y se guardan cifrados en la base. Después de desplegar,
# entrá ahí y configurá el correo y Twilio para que anden los OTP y los mails.
