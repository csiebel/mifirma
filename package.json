{
  "name": "mifirma-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MiFirma — API de firma electrónica de documentos",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/pdf/*.test.ts",
    "test:pdf": "tsx --test test/pdf/*.test.ts",
    "provisionar": "tsx scripts/provisionar.ts",
    "set-password": "tsx scripts/set-password.ts",
    "operador": "tsx scripts/operador.ts",
    "correo": "tsx scripts/correo.ts",
    "migrate": "for f in migrations/0*.sql; do psql \"$MIFIRMA_DB\" -v ON_ERROR_STOP=1 -q -f \"$f\" || break; done"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@signpdf/placeholder-plain": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "@signpdf/utils": "^3.3.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.11.0",
    "jose": "^5.9.6",
    "kysely": "^0.29.4",
    "node-forge": "^1.4.0",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.15.1",
    "pg": "^8.12.0",
    "read-excel-file": "^9.3.8",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^6.4.16",
    "@types/pdfkit": "^0.13.5",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "form-data": "^4.0.6",
    "pdfkit": "^0.15.1"
  }
}
